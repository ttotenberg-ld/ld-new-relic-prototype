# --- New Relic ---
# Ingest license key: https://docs.newrelic.com/docs/apis/intro-apis/new-relic-api-keys/#ingest-license-key
NEW_RELIC_LICENSE_KEY=
# How the app appears in New Relic APM
NEW_RELIC_APP_NAME="LaunchDarkly NR Demo"

# --- LaunchDarkly ---
# Server-side SDK key for the demo project/environment
# (setup_launchdarkly.py prints this for you after it provisions the project)
LAUNCHDARKLY_SDK_KEY=
# API access token (used only by setup_launchdarkly.py to create the project + flags)
LD_API_KEY=
# Demo project/environment created by setup_launchdarkly.py
LD_PROJECT_KEY=nr-ld-demo
LD_ENVIRONMENT=production

# --- App ---
APP_PORT=5050
